# 被评测对象 sk-knowledge 的连接信息。
# 复制为 .env 后填写真实值，.env 不进版本库。

SK_RAG_BASE_URL=http://127.0.0.1:8082
SK_RAG_USERNAME=admin
SK_RAG_PASSWORD=CHANGE_ME
SK_RAG_KNOWLEDGE_ID=1
SK_RAG_MODEL_ID=2
# Qwen3-8B 是推理模型，单次问答实测约 90 秒，超时需留足余量
SK_RAG_TIMEOUT_S=180

# 可恢复错误的重试次数与退避（秒）。
# 评测平台自己也要扛得住抖动：一轮 50 条，任何一次网络失败如果被记成
# "这条没答对"，就等于把平台的问题算到了被测系统头上。
# 只重试与被测系统能力无关的失败：超时 / 连接失败 / 5xx / 限流 / 未收到 done 帧。
SK_RAG_MAX_RETRIES=2
SK_RAG_RETRY_BACKOFF=1

# 向量库直连地址，用于核对灌库结果（knowledge_doc.vector_status 不可信，见 corpus/ingest.py）
SK_WEAVIATE_URL=http://127.0.0.1:18088

# 嵌入模型（用于独立检索探针：评测平台自己把问题向量化后直接查 Weaviate）。
# 必须与被评测服务使用的嵌入模型一致，否则探针结果不可比。
SK_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
SK_EMBEDDING_API_KEY=CHANGE_ME
SK_EMBEDDING_MODEL=BAAI/bge-m3

# 单价（元 / 百万 token），用于把 token 换算成成本。
# 刻意不给默认值：不填则 cost_amount 记 null，而不是写一个猜出来的数字。
SK_PRICE_INPUT_PER_MTOKEN=
SK_PRICE_OUTPUT_PER_MTOKEN=
